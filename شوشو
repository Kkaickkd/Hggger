javascript:(function () {
  function startBot() {
    if (window.najdBotExists) {
      console.log("البوت شغال بالفعل!");
      return;
    }

    window.najdBotExists = window.najdBotEnabled = true;

    /* ============================================================
       1. الإعدادات ومحركات الذاكرة
       ============================================================ */

    let apiKeys = [];
    let currentKeyIndex = parseInt(
      localStorage.getItem("MY_GEMINI_KEY_INDEX") || "0"
    );

    // محرك RAG المحلي
    let ragDatabase = [];

    // حالة المشروع
    let currentProjectState = {};

    function collectKeys() {
      let newKeys = [];
      let count = 1;

      while (true) {
        let input = prompt(
          `🔑 أدخل المفتاح رقم ${count}\n(أو اكتب 'انهاء' للحفظ):`
        );

        if (input === null) break;

        input = input.trim();

        if (input === "انهاء" || input === "إنهاء") break;

        if (input !== "") {
          newKeys.push(input);
          count++;
        }
      }

      return newKeys;
    }

    function loadKeys() {
      let storedKeys = localStorage.getItem("MY_GEMINI_KEYS_LIST");

      if (!storedKeys || storedKeys.trim() === "") {
        let collected = collectKeys();

        if (collected.length > 0) {
          localStorage.setItem(
            "MY_GEMINI_KEYS_LIST",
            collected.join(",")
          );

          apiKeys = collected;
          return true;
        }

        return false;
      }

      apiKeys = storedKeys
        .split(",")
        .map(k => k.trim())
        .filter(k => k);

      return apiKeys.length > 0;
    }

    if (!loadKeys()) {
      alert("لم يتم إدخال مفاتيح صالحة. تم إيقاف التشغيل.");
      return;
    }

    // Gemini 3.6 Flash
    const GEMINI_MODEL = "gemini-3.6-flash";

    const settings = {
      max_tokens: 800,

      systemPrompt: `أنت وكيل ذكي متقدم لبرمجة وأتمتة المهام (مثل معالجة النصوص، سحب البيانات، والسكربتات).
أجب بكلمات قليلة جداً وبدون تنسيقات ماركداون.

[قاعدة صارمة للذاكرة - JSON State]:
في نهاية كل رد، يجب أن تستخرج حالة المشروع الحالية وتكتبها بصيغة JSON صحيحة حصراً داخل وسم <state> و </state>.

مثال:
<state>
{"topic":"text processing","task":"adding delays","language":"python"}
</state>`
    };

    /* ============================================================
       2. البحث في ذاكرة RAG
       ============================================================ */

    function searchRAG(query) {
      if (ragDatabase.length === 0) return [];

      const keywords = query
        .split(/\s+/)
        .filter(w => w.length > 3);

      if (keywords.length === 0) return [];

      let scoredDB = ragDatabase.map(entry => {
        let score = 0;

        keywords.forEach(kw => {
          if (entry.text.includes(kw)) {
            score++;
          }
        });

        return {
          ...entry,
          score
        };
      });

      return scoredDB
        .filter(e => e.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 2);
    }

    /* ============================================================
       3. لوحة التحكم
       ============================================================ */

    if (document.getElementById("bot-logger-panel")) {
      document.getElementById("bot-logger-panel").remove();
    }

    const panel = document.createElement("div");

    panel.id = "bot-logger-panel";

    Object.assign(panel.style, {
      position: "fixed",
      top: "10px",
      right: "10px",
      width: "380px",
      height: "220px",
      backgroundColor: "#11111b",
      color: "#cdd6f4",
      border: "2px solid #89b4fa",
      borderRadius: "8px",
      zIndex: "999999",
      fontFamily: "monospace",
      fontSize: "11px",
      display: "flex",
      flexDirection: "column",
      direction: "ltr",
      boxShadow: "0 4px 20px rgba(0,0,0,0.7)",
      overflow: "hidden"
    });

    panel.innerHTML = `
      <div style="
        background:#1e1e2e;
        padding:4px 8px;
        border-bottom:1px solid #45475a;
        display:flex;
        justify-content:space-between;
        align-items:center;
      ">
        <b style="color:#89b4fa;font-size:11px;">
          🤖 Agentic RAG Bot - Gemini 3.6
        </b>

        <div>
          <button id="btn-key-log"
            style="
              background:#f9e2af;
              color:#11111b;
              border:none;
              padding:2px 5px;
              cursor:pointer;
              border-radius:4px;
              font-size:10px;
            ">
            🔑
          </button>

          <button id="btn-clear-log"
            style="
              background:#f38ba8;
              color:#11111b;
              border:none;
              padding:2px 4px;
              cursor:pointer;
              border-radius:4px;
              font-size:10px;
            ">
            مسح
          </button>

          <button id="btn-close-log"
            style="
              background:#6c7086;
              color:#fff;
              border:none;
              padding:2px 4px;
              cursor:pointer;
              border-radius:4px;
              font-size:10px;
            ">
            ✕
          </button>
        </div>
      </div>

      <div id="log-content"
        style="
          flex:1;
          padding:6px;
          overflow-y:auto;
          white-space:pre-wrap;
          word-break:break-all;
          line-height:1.3;
        ">
      </div>
    `;

    document.body.appendChild(panel);

    const logContainer =
      document.getElementById("log-content");

    function addLog(msg, type = "INFO") {
      const time = new Date().toLocaleTimeString();

      let color = "#cdd6f4";

      if (type === "SUCCESS") color = "#a6e3a1";
      if (type === "ERROR") color = "#f38ba8";
      if (type === "RAG") color = "#f5c2e7";
      if (type === "STATE") color = "#fab387";
      if (type === "WARN") color = "#f9e2af";

      const line = document.createElement("div");

      line.style.color = color;
      line.style.marginBottom = "3px";

      line.innerText =
        `[${time}] [${type}] ${msg}`;

      logContainer.appendChild(line);

      logContainer.scrollTop =
        logContainer.scrollHeight;
    }

    document.getElementById("btn-key-log").onclick = () => {
      let collected = collectKeys();

      if (collected.length > 0) {
        localStorage.setItem(
          "MY_GEMINI_KEYS_LIST",
          collected.join(",")
        );

        localStorage.setItem(
          "MY_GEMINI_KEY_INDEX",
          "0"
        );

        currentKeyIndex = 0;
        apiKeys = collected;

        addLog(
          `تم اعتماد ${apiKeys.length} مفاتيح بنجاح!`,
          "SUCCESS"
        );
      }
    };

    document.getElementById("btn-clear-log").onclick = () => {
      logContainer.innerHTML = "";
    };

    document.getElementById("btn-close-log").onclick = () => {
      panel.remove();
    };

    /* ============================================================
       4. زر تشغيل / إيقاف
       ============================================================ */

    const btn = document.createElement("button");

    Object.assign(btn.style, {
      position: "fixed",
      top: "10px",
      left: "10px",
      zIndex: "99999",
      width: "20px",
      height: "20px",
      borderRadius: "50%",
      border: "2px solid #fff",
      backgroundColor: "#2ecc71",
      cursor: "pointer",
      boxShadow: "0 0 8px rgba(0,0,0,0.5)"
    });

    document.body.appendChild(btn);

    btn.onclick = () => {
      window.najdBotEnabled =
        !window.najdBotEnabled;

      btn.style.backgroundColor =
        window.najdBotEnabled
          ? "#2ecc71"
          : "#e74c3c";

      addLog(
        `تم ${
          window.najdBotEnabled
            ? "تفعيل"
            : "إيقاف"
        } البوت`,
        "WARN"
      );
    };

    /* ============================================================
       5. إرسال الرد للشات
       ============================================================ */

    let lastBotReplyText = "";
    let lastBotReplyTime = 0;

    function sendToChat(text) {
      lastBotReplyText = String(text || "");
      lastBotReplyTime = Date.now();

      const input =
        document.querySelector("#tbox");

      const btnSend =
        document.querySelector(".btn-primary") ||
        document.querySelector("#sendbtn");

      if (!input) {
        addLog(
          "❌ لم يتم العثور على مربع النص!",
          "ERROR"
        );

        return;
      }

      input.value = text;

      ["input", "change"].forEach(ev => {
        input.dispatchEvent(
          new Event(ev, {
            bubbles: true
          })
        );
      });

      setTimeout(() => {
        if (
          typeof Tsend_TIGERHOST_UPLOAD ===
          "function"
        ) {
          Tsend_TIGERHOST_UPLOAD();
        } else if (btnSend) {
          btnSend.click();
        }
      }, 50);
    }

    /* ============================================================
       6. تقسيم الرد
       ============================================================ */

    function processAndSendReply(fullReply) {
      let cleanText =
        fullReply
          .replace(/[*_~`#\[\]\(\)>\\-]/g, "")
          .trim();

      const words =
        cleanText
          .split(/\s+/)
          .filter(Boolean);

      if (words.length === 0) return;

      const chunks = [];

      for (
        let i = 0;
        i < words.length;
        i += 49
      ) {
        chunks.push(
          words
            .slice(i, i + 49)
            .join(" ")
        );
      }

      chunks.forEach((chunk, index) => {
        setTimeout(() => {
          sendToChat(chunk);
        }, index * 1500);
      });
    }

    /* ============================================================
       7. Gemini 3.6 Flash API
       
       ملاحظة:
       Gemini 3.6 لا يستخدم temperature/top_p/top_k.
       ============================================================ */

    async function requestGeminiAPI(
      promptText,
      retryCount = 0
    ) {
      if (apiKeys.length === 0) return;

      if (retryCount >= apiKeys.length) {
        addLog(
          "❌ جميع المفاتيح استنفدت!",
          "ERROR"
        );

        return;
      }

      currentKeyIndex =
        currentKeyIndex % apiKeys.length;

      const activeKey =
        apiKeys[currentKeyIndex];

      /* ----------------------------------------------------------
         RAG
         ---------------------------------------------------------- */

      const relevantContext =
        searchRAG(promptText);

      let contextText = "";

      if (relevantContext.length > 0) {
        contextText =
          "معلومات مسترجعة من المحادثة السابقة قد تفيدك:\n" +
          relevantContext
            .map(r =>
              `- ${
                r.role === "user"
                  ? "المستخدم قال"
                  : "أنت قلت"
              }: ${r.text}`
            )
            .join("\n");

        addLog(
          `تم استرجاع ${relevantContext.length} سجلات من الذاكرة العميقة`,
          "RAG"
        );
      }

      /* ----------------------------------------------------------
         JSON State
         ---------------------------------------------------------- */

      let activeSystemPrompt =
        settings.systemPrompt;

      if (
        Object.keys(currentProjectState)
          .length > 0
      ) {
        activeSystemPrompt +=
          `\n\n[بيانات المشروع الحالية - JSON State]:\n` +
          JSON.stringify(
            currentProjectState
          );
      }

      /* ----------------------------------------------------------
         بناء محتوى الطلب
         ---------------------------------------------------------- */

      let requestContents = [];

      if (contextText) {
        requestContents.push({
          role: "user",
          parts: [
            {
              text: contextText
            }
          ]
        });
      }

      requestContents.push({
        role: "user",
        parts: [
          {
            text: promptText
          }
        ]
      });

      const url =
        `https://generativelanguage.googleapis.com/v1beta/models/` +
        `${GEMINI_MODEL}:generateContent?key=${activeKey}`;

      try {
        addLog(
          `جاري الإرسال إلى ${GEMINI_MODEL}...`,
          "INFO"
        );

        const response =
          await fetch(url, {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({
              systemInstruction: {
                parts: [
                  {
                    text:
                      activeSystemPrompt
                  }
                ]
              },

              contents:
                requestContents,

              generationConfig: {
                maxOutputTokens:
                  settings.max_tokens
              }
            })
          });

        const data =
          await response.json();

        /* --------------------------------------------------------
           تبديل المفتاح عند مشاكل API
           -------------------------------------------------------- */

        if (!response.ok) {
          if (
            [429, 403, 503].includes(
              response.status
            )
          ) {
            addLog(
              `⚠️ تبديل المفتاح من رقم ${
                currentKeyIndex + 1
              }...`,
              "WARN"
            );

            currentKeyIndex =
              (currentKeyIndex + 1) %
              apiKeys.length;

            localStorage.setItem(
              "MY_GEMINI_KEY_INDEX",
              currentKeyIndex
            );

            return requestGeminiAPI(
              promptText,
              retryCount + 1
            );
          }

          addLog(
            `فشل الطلب: ${
              data?.error?.message ||
              response.statusText
            }`,
            "ERROR"
          );

          return;
        }

        /* --------------------------------------------------------
           استخراج الرد
           -------------------------------------------------------- */

        let reply =
          data
            ?.candidates?.[0]
            ?.content?.parts?.[0]
            ?.text
            ?.trim();

        if (!reply) {
          addLog(
            "⚠️ Gemini أرجع ردًا فارغًا!",
            "WARN"
          );

          return;
        }

        /* --------------------------------------------------------
           استخراج JSON State
           -------------------------------------------------------- */

        const stateMatch =
          reply.match(
            /<state>([\s\S]*?)<\/state>/i
          );

        if (stateMatch) {
          try {
            const parsedState =
              JSON.parse(
                stateMatch[1].trim()
              );

            currentProjectState = {
              ...currentProjectState,
              ...parsedState
            };

            addLog(
              "تم تحديث حالة المشروع ⚙️",
              "STATE"
            );

          } catch (e) {
            addLog(
              "فشل قراءة JSON من Gemini",
              "WARN"
            );
          }

          reply =
            reply.replace(
              /<state>[\s\S]*?<\/state>/ig,
              ""
            ).trim();
        }

        /* --------------------------------------------------------
           حفظ المحادثة في RAG
           -------------------------------------------------------- */

        ragDatabase.push({
          role: "user",
          text: promptText
        });

        ragDatabase.push({
          role: "model",
          text: reply
        });

        if (ragDatabase.length > 200) {
          ragDatabase =
            ragDatabase.slice(
              ragDatabase.length - 200
            );
        }

        addLog(
          "تم استلام الرد من Gemini 3.6 بنجاح",
          "SUCCESS"
        );

        processAndSendReply(reply);

      } catch (error) {
        addLog(
          `خطأ اتصال: ${error.message}`,
          "ERROR"
        );
      }
    }

    /* ============================================================
       8. مراقبة الشات
       ============================================================ */

    const chatBox =
      document.querySelector("#d2");

    if (!chatBox) {
      return addLog(
        "❌ لم يتم العثور على صندوق الشات",
        "ERROR"
      );
    }

    const regexLeadingClean =
      /^[\s\-،,.]+/;

    const botObserver =
      new MutationObserver(
        mutations => {

          if (!window.najdBotEnabled)
            return;

          for (const m of mutations) {

            for (const node of m.addedNodes) {

              if (node.nodeType !== 1)
                continue;

              const msgNode =
                node.querySelector(
                  ".u-msg, .msg"
                ) || node;

              let msgText =
                msgNode.textContent || "";

              if (
                !msgText ||
                (
                  msgText ===
                    lastBotReplyText &&
                  Date.now() -
                    lastBotReplyTime <
                    8000
                )
              ) {
                continue;
              }

              let trimmed =
                msgText.trim();

              if (
                !trimmed.startsWith("نجد")
              ) {
                continue;
              }

              const nameEl =
                node.querySelector(
                  ".u-topic, .u-name, .name"
                );

              if (
                nameEl &&
                msgText.includes(
                  nameEl.textContent
                )
              ) {
                msgText =
                  msgText.replace(
                    nameEl.textContent,
                    ""
                  );
              }

              let cleanMsg =
                msgText
                  .replace(
                    regexLeadingClean,
                    ""
                  )
                  .trim();

              if (
                !cleanMsg.startsWith("نجد")
              ) {
                continue;
              }

              const promptMsg =
                cleanMsg
                  .replace(
                    /^نجد\s*/,
                    ""
                  )
                  .trim();

              if (!promptMsg)
                continue;

              /* --------------------------------------------------
                 أوامر الذاكرة
                 -------------------------------------------------- */

              if (
                promptMsg === "فرمتة" ||
                promptMsg ===
                  "امسح الذاكرة"
              ) {

                ragDatabase = [];
                currentProjectState = {};

                addLog(
                  "تمت فرمتة جميع محركات الذاكرة (RAG + JSON) 🧹",
                  "WARN"
                );

                sendToChat(
                  "تم مسح قواعد البيانات وحالة المشروع. نبدأ من الصفر!"
                );

                continue;
              }

              addLog(
                `معالجة: "${promptMsg}"`,
                "INFO"
              );

              requestGeminiAPI(
                promptMsg
              );
            }
          }
        }
      );

    botObserver.observe(
      chatBox,
      {
        childList: true,
        subtree: true
      }
    );

    addLog(
      "تم تشغيل البوت باستخدام Gemini 3.6 Flash 🚀",
      "SUCCESS"
    );
  }

  startBot();

})();
