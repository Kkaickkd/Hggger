javascript: (function () {
  function startBot() {
    if (window.wikiWpmBotExists) {
      console.log("البوت شغال بالفعل!");
      return;
    }
    window.wikiWpmBotExists = window.wikiWpmBotEnabled = true;

    /* ============================================================
       1. مفتاح Google Gemini API والنموذج المطلوب
       ============================================================ */
    let GEMINI_API_KEY = localStorage.getItem("MY_GEMINI_KEY");
    if (!GEMINI_API_KEY || GEMINI_API_KEY.trim() === "") {
      GEMINI_API_KEY = prompt("🔑 أدخل مفتاح Gemini API الخاص بك لتشغيل البوت:");
      if (GEMINI_API_KEY && GEMINI_API_KEY.trim() !== "") {
        localStorage.setItem("MY_GEMINI_KEY", GEMINI_API_KEY.trim());
      }
    }

    // تم تثبيت النموذج الذي اخترته والمطلوب من السيرفر تماماً
    const GEMINI_MODEL = "gemini-3.6-flash";

    const settings = {
      temperature: 0.7,
      max_tokens: 1000,
      systemPrompt: "أنت مساعد ذكاء اصطناعي متكامل ومفيد. رَد على المستخدم بوضوح ومهارة وبلغة عربية سلسة. لا تذكر أنك ذكاء اصطناعي إلا إذا سئلت مباشرة."
    };

    /* ============================================================
       2. نافذة اللوق المباشرة
       ============================================================ */
    if (document.getElementById("bot-logger-panel")) {
      document.getElementById("bot-logger-panel").remove();
    }

    const panel = document.createElement("div");
    panel.id = "bot-logger-panel";
    Object.assign(panel.style, {
      position: "fixed", top: "10px", right: "10px", width: "360px", height: "200px",
      backgroundColor: "#11111b", color: "#cdd6f4", border: "2px solid #89b4fa",
      borderRadius: "8px", zIndex: "999999", fontFamily: "monospace", fontSize: "11px",
      display: "flex", flexDirection: "column", direction: "ltr",
      boxShadow: "0 4px 20px rgba(0,0,0,0.7)", overflow: "hidden"
    });

    panel.innerHTML = `
      <div style="background: #1e1e2e; padding: 4px 8px; border-bottom: 1px solid #45475a; display: flex; justify-content: space-between; align-items: center;">
        <b style="color: #89b4fa; font-size: 11px;">🤖 Gemini Bot Panel</b>
        <div>
          <button id="btn-key-log" style="background: #f9e2af; color: #11111b; border: none; padding: 2px 5px; font-weight: bold; cursor: pointer; border-radius: 4px; font-size: 10px; margin-right: 3px;">🔑 المفتاح</button>
          <button id="btn-clear-log" style="background: #f38ba8; color: #11111b; border: none; padding: 2px 4px; font-weight: bold; cursor: pointer; border-radius: 4px; font-size: 10px; margin-right: 3px;">مسح</button>
          <button id="btn-close-log" style="background: #6c7086; color: #fff; border: none; padding: 2px 4px; cursor: pointer; border-radius: 4px; font-size: 10px;">✕</button>
        </div>
      </div>
      <div id="log-content" style="flex: 1; padding: 6px; overflow-y: auto; white-space: pre-wrap; word-break: break-all; line-height: 1.3; font-size: 10px;"></div>
    `;
    document.body.appendChild(panel);

    const logContainer = document.getElementById("log-content");
    
    function addLog(msg, type = "INFO") {
      const time = new Date().toLocaleTimeString();
      let color = "#cdd6f4";
      if (type === "SUCCESS") color = "#a6e3a1";
      if (type === "ERROR") color = "#f38ba8";
      if (type === "WARN") color = "#f9e2af";
      if (type === "INFO") color = "#89b4fa";
      const line = document.createElement("div");
      line.style.color = color; line.style.marginBottom = "2px";
      line.innerText = `[${time}] [${type}] ${msg}`;
      logContainer.appendChild(line);
      logContainer.scrollTop = logContainer.scrollHeight;
    }

    document.getElementById("btn-key-log").onclick = () => {
      const newKey = prompt("🔑 أدخل مفتاح Gemini API الخاص بك:", GEMINI_API_KEY || "");
      if (newKey && newKey.trim() !== "") {
        GEMINI_API_KEY = newKey.trim();
        localStorage.setItem("MY_GEMINI_KEY", GEMINI_API_KEY);
        addLog("تم تحديث وحفظ مفتاح Gemini API بنجاح!", "SUCCESS");
      }
    };
    document.getElementById("btn-clear-log").onclick = () => (logContainer.innerHTML = "");
    document.getElementById("btn-close-log").onclick = () => panel.remove();

    addLog("تم تشغيل البوت بنجاح! جاهز لاستقبال رسائل 'نجد!'", "SUCCESS");

    /* ============================================================
       زر التحكم (أخضر/أحمر)
       ============================================================ */
    const btn = document.createElement("button");
    Object.assign(btn.style, {
      position: "fixed", top: "10px", left: "10px", zIndex: "99999", width: "20px", height: "20px",
      borderRadius: "50%", border: "2px solid #fff", backgroundColor: "#2ecc71",
      cursor: "pointer", boxShadow: "0 0 8px rgba(0,0,0,0.5)",
    });
    document.body.appendChild(btn);
    btn.onclick = () => {
      window.wikiWpmBotEnabled = !window.wikiWpmBotEnabled;
      btn.style.backgroundColor = window.wikiWpmBotEnabled ? "#2ecc71" : "#e74c3c";
      addLog(`تم ${window.wikiWpmBotEnabled ? 'تفعيل' : 'إيقاف'} البوت`, "WARN");
    };

    /* ============================================================
       دالة الإرسال إلى الشات
       ============================================================ */
    let lastBotReplyText = "";
    let lastBotReplyTime = 0;

    function sendToChat(text) {
      lastBotReplyText = String(text || "");
      lastBotReplyTime = Date.now();
      const input = document.querySelector("#tbox");
      const btnSend = document.querySelector(".btn-primary") || document.querySelector("#sendbtn");
      
      if (!input) {
        addLog("❌ لم يتم العثور على مربع النص #tbox!", "ERROR");
        return;
      }
      
      input.value = text;
      ["input", "change"].forEach(ev => input.dispatchEvent(new Event(ev, { bubbles: true })));
      
      setTimeout(() => {
        if (typeof Tsend_TIGERHOST_UPLOAD === "function") {
          Tsend_TIGERHOST_UPLOAD();
        } else if (btnSend) {
          btnSend.click();
        }
        addLog("تم إرسال الرد إلى الشات بنجاح.", "SUCCESS");
      }, 50);
    }

    /* ============================================================
       الإتصال المباشر والصارم بـ Gemini API
       ============================================================ */
    async function requestGeminiAPI(promptText) {
      if (!GEMINI_API_KEY) {
        addLog("⚠️ لم يتم إدخال مفتاح API!", "ERROR");
        return;
      }

      addLog(`جاري الإرسال إلى API (${GEMINI_MODEL}): "${promptText}"`, "INFO");

      const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${GEMINI_API_KEY}`;

      try {
        const response = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            systemInstruction: {
              parts: [{ text: settings.systemPrompt }]
            },
            contents: [{ role: "user", parts: [{ text: promptText }] }],
            generationConfig: {
              temperature: settings.temperature,
              maxOutputTokens: settings.max_tokens
            }
          })
        });

        const data = await response.json();

        if (!response.ok) {
          const errMsg = data?.error?.message || response.statusText;
          addLog(`فشل طلب API (${response.status}): ${errMsg}`, "ERROR");
          return;
        }

        const reply = data?.candidates?.[0]?.content?.parts?.[0]?.text?.trim();
        if (reply) {
          addLog("تم استلام الرد بنجاح!", "SUCCESS");
          sendToChat(reply);
        } else {
          addLog("الرد المستلم من API فارغ!", "WARN");
        }

      } catch (error) {
        addLog(`خطأ اتصال: ${error.message}`, "ERROR");
      }
    }

    /* ============================================================
       مراقبة الرسائل (Triggers)
       ============================================================ */
    const chatBox = document.querySelector("#d2");
    if (!chatBox) {
      addLog("❌ لم يتم العثور على صندوق الشات (#d2)", "ERROR");
      return;
    }

    const regexLeadingClean = /^[\s\-،,.]+/;

    const botObserver = new MutationObserver((mutations) => {
      if (!window.wikiWpmBotEnabled) return;
      for (const m of mutations) {
        for (const node of m.addedNodes) {
          if (node.nodeType !== 1) continue;

          const msgNode = node.querySelector(".u-msg, .msg") || node;
          let msgText = msgNode.textContent || "";
          
          if (!msgText || (msgText === lastBotReplyText && Date.now() - lastBotReplyTime < 8000)) continue;

          let trimmed = msgText.trim();
          if (!trimmed.startsWith("نجد!")) continue;

          const nameEl = node.querySelector(".u-topic, .u-name, .name");
          if (nameEl && msgText.includes(nameEl.textContent)) {
            msgText = msgText.replace(nameEl.textContent, "");
          }

          let cleanMsg = msgText.replace(regexLeadingClean, "").trim();
          if (!cleanMsg.startsWith("نجد!")) continue;

          const promptMsg = cleanMsg.replace(/^نجد!\s*/, "").trim();
          
          if (promptMsg) {
            addLog(`رصد رسالة: "${promptMsg}"`, "INFO");
            requestGeminiAPI(promptMsg);
          }
        }
      }
    });

    botObserver.observe(chatBox, { childList: true, subtree: true });

  }
  startBot();
})();
